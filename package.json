{
  "name": "node-template-server",
  "version": "1.0.0",
  "description": "Its an backend server template ",
  "bin": "bin/createNodejsApp.js",
  "main": "src/index.js",
  "author": "Akshay Pareek",
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "pm2 start ecosystem.config.json --no-daemon",
    "dev": "cross-env NODE_ENV=development nodemon --exec \"node --disable-warning=DEP0170\" src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules node --stack-size=65536 ./node_modules/jest/bin/jest.js -i --colors --verbose --detectOpenHandles",
    "test:catalog": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -i --colors --verbose --detectOpenHandles tests/integration/catalog.test.js",
    "test:fabric": "cross-env NODE_OPTIONS=--experimental-vm-modules jest -i --colors --verbose --detectOpenHandles tests/integration/fabric.test.js",
    "smoke:catalog": "node scripts/smoke-test-catalog.js",
    "test:watch": "jest -i --watchAll",
    "coverage": "jest -i --coverage",
    "coverage:coveralls": "jest -i --coverage --coverageReporters=text-lcov | coveralls",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:test": "docker-compose -f docker-compose.yml -f docker-compose.test.yml up",
    "seed:superadmin": "node scripts/seedSuperAdmin.js",
    "seed:catalog": "node scripts/seedCatalogSample.js",
    "seed:fabric": "node scripts/seedFabricMasters.js",
    "seed:fabric-checkpoints": "node scripts/seedFabricCheckpoints.js",
    "seed:catalog-checkpoints": "node scripts/seedCatalogCheckpoints.js",
    "seed:production-checkpoints": "node scripts/seedProductionCheckpoints.js",
    "fix:fabric-names": "node scripts/fix-fabric-catalog-names.js",
    "racks:force-delete": "node --disable-warning=DEP0170 scripts/force-delete-racks.js",
    "orders:clear": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/clear-production-orders.js",
    "seed:vertical-cut-demo": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/seed-vertical-cut-demo.js",
    "seed:production-catalog-demo": "node --disable-warning=DEP0170 scripts/seedProductionCatalogDemo.js",
    "seed:floor-equipment": "node --disable-warning=DEP0170 scripts/seedFloorEquipment.js",
    "seed:floor-racks": "node --disable-warning=DEP0170 scripts/seedFloorRacks.js",
    "patch:qc-processes": "node --disable-warning=DEP0170 scripts/patchQcProcessMasters.js",
    "seed:demo-plain-hanky-order": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/seed-demo-plain-hanky-order.js",
    "seed:demo-embroidery-order": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/seed-demo-embroidery-order.js",
    "seed:demo-embroidery-floral-order": "cross-env NODE_ENV=development DEMO_FACTORY_CODE=HK-D-EMB-02 DEMO_ORDER_NOTE=\"Demo Embroidery Floral\" DEMO_BUYER=\"Demo buyer\" DEMO_ORDER_QTY=120 node --disable-warning=DEP0170 scripts/seed-demo-embroidery-order.js",
    "audit:demo-order-flow": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/audit-demo-order-flow.js",
    "racks:ensure-production": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/migrate-production-racks.js",
    "e2e:multi-order-flow": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/e2e-multi-order-flow.js",
    "e2e:dispatch-orders": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/e2e-ten-orders-dispatch.js",
    "e2e:ten-floor-dispatch": "cross-env NODE_ENV=development E2E_FLOOR_LOOP=10 E2E_FLOOR_ONLY=1 node --disable-warning=DEP0170 scripts/e2e-multi-order-flow.js",
    "e2e:production-gate": "npm run e2e:multi-order-flow && npm run e2e:dispatch-orders",
    "e2e:production-gate-full": "npm run e2e:multi-order-flow && npm run e2e:ten-floor-dispatch && npm run e2e:dispatch-orders",
    "rollback:bundle-iron": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/rollback-bundle-for-iron.js",
    "rollback:bundle-emb-thread": "cross-env NODE_ENV=development node --disable-warning=DEP0170 scripts/rollback-bundle-for-embroidery-thread.js",
    "sync:ec2-to-atlas": "bash scripts/sync-ec2-production-to-atlas.sh"
  },
  "keywords": [
    "node",
    "node.js",
    "boilerplate",
    "generator",
    "express",
    "rest",
    "api",
    "mongodb",
    "mongoose",
    "es6",
    "es7",
    "es8",
    "es9",
    "jest",
    "travis",
    "docker",
    "passport",
    "joi",
    "eslint",
    "prettier"
  ],
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.0",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^5.0.0",
    "helmet": "^4.1.0",
    "http-status": "^1.4.0",
    "joi": "^17.3.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.24.0",
    "mongoose": "^5.7.7",
    "morgan": "^1.9.1",
    "multer": "^2.2.0",
    "nodemailer": "^6.3.1",
    "openai": "^5.23.2",
    "passport": "^0.4.0",
    "passport-jwt": "^4.0.0",
    "pm2": "^5.1.0",
    "swagger-jsdoc": "^6.0.8",
    "swagger-ui-express": "^4.1.6",
    "uuid": "^14.0.1",
    "validator": "^13.0.0",
    "winston": "^3.2.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/faker": "^6.6.8",
    "coveralls": "^3.0.7",
    "eslint": "^7.0.0",
    "eslint-config-airbnb-base": "^14.0.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jest": "^24.0.1",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-security": "^1.4.0",
    "faker": "^5.1.0",
    "jest": "^26.0.1",
    "node-mocks-http": "^1.8.0",
    "nodemon": "^2.0.0",
    "prettier": "^2.0.5",
    "supertest": "^6.0.1"
  },
  "type": "module"
}
